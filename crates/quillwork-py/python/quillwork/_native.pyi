    def text(self, node: int) -> str | None: ...
    def text_content(self, node: int) -> str: ...
    def set_text(self, node: int, text: str) -> None: ...
    def source_span(self, node: int) -> tuple[int, int] | None: ...
    # structure
    def create_element(self, qname: str) -> int: ...
    def create_text(self, text: str) -> int: ...
    def create_comment(self, text: str) -> int: ...
    def clone_subtree(self, node: int) -> int: ...
    def append_child(self, parent: int, child: int) -> None:
        """An attached ``child`` is moved, not copied (``clone_subtree`` copies)."""
    def prepend_child(self, parent: int, child: int) -> None:
        """An attached ``child`` is moved, not copied (``clone_subtree`` copies)."""
    def insert_before(self, reference: int, new: int) -> None:
        """An attached ``new`` is moved, not copied (``clone_subtree`` copies)."""
    def insert_after(self, reference: int, new: int) -> None:
        """An attached ``new`` is moved, not copied (``clone_subtree`` copies)."""
    def detach(self, node: int) -> None: ...
