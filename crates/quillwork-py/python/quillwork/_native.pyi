        ratio_min_size: int | None = None,
        max_entries: int | None = None,
    ) -> None: ...
    @property
    def max_total_uncompressed(self) -> int: ...
    @property
    def max_part_size(self) -> int: ...
    @property
    def max_ratio(self) -> int: ...
    @property
    def ratio_min_size(self) -> int: ...
    @property
    def max_entries(self) -> int: ...

