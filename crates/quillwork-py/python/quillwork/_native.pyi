    # node info
    def kind(self, node: int) -> NodeKind | None: ...
    def name(self, node: int) -> str | None: ...
    def local_name(self, node: int) -> str | None: ...
    def prefix(self, node: int) -> str | None: ...
    def namespace(self, node: int) -> str | None: ...
    def matches(self, node: int, ns: str, local: str) -> bool: ...
    def lookup_namespace(self, node: int, prefix: str) -> str | None: ...
    # navigation
    def parent(self, node: int) -> int | None: ...
    def first_child(self, node: int) -> int | None: ...
    def last_child(self, node: int) -> int | None: ...
    def next_sibling(self, node: int) -> int | None: ...
    def prev_sibling(self, node: int) -> int | None: ...
    def children(self, node: int) -> list[int]: ...
    def child_elements(self, node: int) -> list[int]: ...
    def descendants(self, node: int) -> list[int]: ...
    def ancestors(self, node: int) -> list[int]: ...
    def find_child(self, node: int, ns: str, local: str) -> int | None: ...
    def find(self, node: int, ns: str, local: str) -> int | None: ...
    def find_all(self, node: int, ns: str, local: str) -> list[int]: ...
    # attributes
    def attr(self, node: int, qname: str) -> str | None: ...
    def attr_ns(self, node: int, ns: str, local: str) -> str | None: ...
    def attrs(self, node: int) -> list[tuple[str, str]]: ...
    def set_attr(self, node: int, qname: str, value: str) -> None: ...
    def set_attr_ns(self, node: int, ns: str, local: str, value: str) -> None: ...
    def remove_attr(self, node: int, qname: str) -> bool: ...
